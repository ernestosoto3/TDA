# General
NODE_ENV=development

# API
API_PORT=3000
API_URL=http://localhost:3000

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000

# Database
# Local development connection. Replace the placeholder only in your private .env file.
DATABASE_URL=postgresql://tda_app:your_local_password@localhost:5432/tda_local

# Automated tests must use a separate database.
TEST_DATABASE_URL=postgresql://tda_app:your_local_password@localhost:5432/tda_test

# Local and test databases do not require SSL.
# Staging must override this value through the deployment platform.
DATABASE_SSL_MODE=disable

# PostgreSQL connection pool
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Notifications
EXPO_PUBLIC_PROJECT_ID=
FIREBASE_PROJECT_ID=